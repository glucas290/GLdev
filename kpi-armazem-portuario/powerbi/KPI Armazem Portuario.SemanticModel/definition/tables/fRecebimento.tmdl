		sourceColumn: JUSTIFICATIVA

	partition fRecebimento = m
		mode: import
		queryGroup: '5 Fatos'
		source =
				let
				    Origem = stg_SP_Recebimento,
				    // 1ª solicitação de posicionamento para desova (planilha do pátio)
				    Solicitacoes = Table.Group(
				        Table.SelectRows(stg_SP_Solicitacoes, each [TIPO_SERVICO] = "DESOVA"), {"CONTAINER"},
				        {{"DATA_SOLICITACAO_POSICIONAMENTO", each List.Min([DATA_SOLICITACAO]), type datetime}, {"LOCAL_PLANEJADO", each List.First([LOCAL_PLANEJADO]), type text}}),
				    // posicionamento executado no TOS; se foi refeito, vale o primeiro
				    Posicionamentos = Table.Group(
				        Table.SelectRows(stg_TOS_Movimentacao, each [TIPO_MOVIMENTO] = "POSICIONAMENTO ARMAZÉM"), {"CONTAINER"},
				        {{"DATA_POSICIONADO", each List.Min([EXECUTADO]), type datetime}}),
				    MesclaSolicitacao = Table.NestedJoin(Origem, {"CONTAINER"}, Solicitacoes, {"CONTAINER"}, "Solic", JoinKind.LeftOuter),
				    ExpandeSolicitacao = Table.ExpandTableColumn(MesclaSolicitacao, "Solic", {"DATA_SOLICITACAO_POSICIONAMENTO", "LOCAL_PLANEJADO"}),
				    MesclaPosicionamento = Table.NestedJoin(ExpandeSolicitacao, {"CONTAINER"}, Posicionamentos, {"CONTAINER"}, "Posic", JoinKind.LeftOuter),
				    ExpandePosicionamento = Table.ExpandTableColumn(MesclaPosicionamento, "Posic", {"DATA_POSICIONADO"}),
				    // a planilha traz o nome do cliente; o modelo usa o código do cadastro do TOS
				    MesclaCliente = Table.NestedJoin(ExpandePosicionamento, {"CLIENTE"}, stg_TOS_Clientes, {"RAZAO_SOCIAL"}, "Cli", JoinKind.LeftOuter),
				    ExpandeCliente = Table.ExpandTableColumn(MesclaCliente, "Cli", {"ID_CLIENTE"}),
				    Cancelada = Table.AddColumn(ExpandeCliente, "CANCELADA", each [DESOVA_CANCELADA] = "SIM", type logical),
				    MetaPosicionamento = Table.AddColumn(Cancelada, "META_POSICIONAMENTO", each fnAplicarMeta([DATA_SOLICITACAO_POSICIONAMENTO], "RECEBIMENTO", "POSICIONAMENTO", "TODOS"), type datetime),
				    MetaDesunitizacao = Table.AddColumn(MetaPosicionamento, "META_DESUNITIZACAO", each fnAplicarMeta([DATA_POSICIONADO], "RECEBIMENTO", "DESUNITIZAÇÃO", "TODOS"), type datetime),
				    MetaArmazenagem = Table.AddColumn(MetaDesunitizacao, "META_ARMAZENAGEM", each fnAplicarMeta([DATA_FIM_DESUNITIZACAO], "RECEBIMENTO", "PRESENÇA DE CARGA", "TODOS"), type datetime),
				    MetaRelatorio = Table.AddColumn(MetaArmazenagem, "META_ENVIO_RELATORIO", each fnAplicarMeta([DATA_FIM_DESUNITIZACAO], "RECEBIMENTO", "ENVIO DO RELATÓRIO", "TODOS"), type datetime),
				    HorasPosicionamento = Table.AddColumn(MetaRelatorio, "HORAS_POSICIONAMENTO", each fnHoras([DATA_SOLICITACAO_POSICIONAMENTO], [DATA_POSICIONADO]), type number),
				    HorasDesunitizacao = Table.AddColumn(HorasPosicionamento, "HORAS_DESUNITIZACAO", each fnHoras([DATA_POSICIONADO], [DATA_FIM_DESUNITIZACAO]), type number),
				    HorasArmazenagem = Table.AddColumn(HorasDesunitizacao, "HORAS_ARMAZENAGEM", each fnHoras([DATA_FIM_DESUNITIZACAO], [DATA_ARMAZENAGEM]), type number),
				    HorasRelatorio = Table.AddColumn(HorasArmazenagem, "HORAS_ENVIO_RELATORIO", each fnHoras([DATA_FIM_DESUNITIZACAO], [DATA_ENVIO_RELATORIO]), type number),
				    LeadTime = Table.AddColumn(HorasRelatorio, "HORAS_LEAD_TIME", each fnHoras([DATA_SOLICITACAO_POSICIONAMENTO], [DATA_ARMAZENAGEM]), type number),
				    DiasPatio = Table.AddColumn(LeadTime, "DIAS_TIME_IN_ATE_SOLICITACAO", each if [TIME_IN] = null or [DATA_SOLICITACAO_POSICIONAMENTO] = null then null else Number.Round(Duration.TotalDays([DATA_SOLICITACAO_POSICIONAMENTO] - [TIME_IN]), 1), type number),
				    StatusPosicionamento = Table.AddColumn(DiasPatio, "STATUS_POSICIONAMENTO", each if [CANCELADA] then null else fnStatusPrazo([DATA_POSICIONADO], [META_POSICIONAMENTO]), type text),
				    StatusDesunitizacao = Table.AddColumn(StatusPosicionamento, "STATUS_DESUNITIZACAO", each if [CANCELADA] then null else fnStatusPrazo([DATA_FIM_DESUNITIZACAO], [META_DESUNITIZACAO]), type text),
				    StatusArmazenagem = Table.AddColumn(StatusDesunitizacao, "STATUS_ARMAZENAGEM", each if [CANCELADA] then null else fnStatusPrazo([DATA_ARMAZENAGEM], [META_ARMAZENAGEM]), type text),
				    StatusRelatorio = Table.AddColumn(StatusArmazenagem, "STATUS_ENVIO_RELATORIO", each if [CANCELADA] then null else fnStatusPrazo([DATA_ENVIO_RELATORIO], [META_ENVIO_RELATORIO]), type text),
				    StatusGeral = Table.AddColumn(StatusRelatorio, "STATUS_GERAL", each
				        let etapas = {[STATUS_POSICIONAMENTO], [STATUS_DESUNITIZACAO], [STATUS_ARMAZENAGEM], [STATUS_ENVIO_RELATORIO]}
				        in if [CANCELADA] then "CANCELADO"
				           else if List.Contains(etapas, "FORA DO PRAZO") then "FORA DO PRAZO"
				           else if List.Contains(etapas, "EM ANDAMENTO") or List.Contains(etapas, null) then "EM ANDAMENTO"
				           else "NO PRAZO", type text),
				    DataReferencia = Table.AddColumn(StatusGeral, "DATA_REFERENCIA", each DateTime.Date(if [DATA_SOLICITACAO_POSICIONAMENTO] <> null then [DATA_SOLICITACAO_POSICIONAMENTO] else [DATA_SOLICITACAO_PROCESSO]), type date),
				    Colunas = Table.SelectColumns(DataReferencia, {
				        "CONTAINER", "BL", "ID_CLIENTE", "TAM", "MODAL", "SERVICO", "ARMADOR", "NAVIO", "TERMINAL_DESCARGA", "FREE_TIME_DIAS", "LOCAL_PLANEJADO",
				        "STATUS_PROCESSO", "CANCELADA", "DATA_REFERENCIA", "FIM_OPERACAO_NAVIO", "TIME_IN", "DATA_SOLICITACAO_PROCESSO", "DATA_SOLICITACAO_POSICIONAMENTO",
				        "DATA_POSICIONADO", "META_POSICIONAMENTO", "DATA_PROGRAMADO", "DATA_FIM_DESUNITIZACAO", "META_DESUNITIZACAO", "DATA_ARMAZENAGEM", "META_ARMAZENAGEM",
				        "DATA_ENVIO_RELATORIO", "META_ENVIO_RELATORIO", "HORAS_POSICIONAMENTO", "HORAS_DESUNITIZACAO", "HORAS_ARMAZENAGEM", "HORAS_ENVIO_RELATORIO",
				        "HORAS_LEAD_TIME", "DIAS_TIME_IN_ATE_SOLICITACAO", "STATUS_POSICIONAMENTO", "STATUS_DESUNITIZACAO", "STATUS_ARMAZENAGEM", "STATUS_ENVIO_RELATORIO",
				        "STATUS_GERAL", "JUSTIFICATIVA"
				    })
				in
				    Colunas

