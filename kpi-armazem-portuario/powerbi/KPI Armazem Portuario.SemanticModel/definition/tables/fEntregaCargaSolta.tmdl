	column JUSTIFICATIVA
		dataType: string
		lineageTag: d5bfaf23-04a4-4023-910d-cddfcfc25c56
		summarizeBy: none
		sourceColumn: JUSTIFICATIVA

	column AREA_RESPONSAVEL
		dataType: string
		lineageTag: 633f624a-0070-4335-89fa-0722a35399ee
		summarizeBy: none
		sourceColumn: AREA_RESPONSAVEL

	partition fEntregaCargaSolta = m
		mode: import
		queryGroup: '5 Fatos'
		source =
				let
				    Origem = stg_TOS_Entrega,
				    TipoAtendimento = Table.AddColumn(Origem, "TIPO_ATENDIMENTO", each
				        if [TIPO_DOCUMENTO] = "DTA" then "DTA"
				        else if [ATENDIMENTO_ESPECIAL] = "S" then "ESPECIAL"
				        else "NORMAL", type text),
				    // chave da justificativa = janela agendada + placa (como no controle da equipe)
				    ChaveJanela = Table.TransformColumns(TipoAtendimento, {{"DATA_JANELA", fnArredondarMinuto, type datetime}}),
				    MesclaJustificativa = Table.NestedJoin(ChaveJanela, {"DATA_JANELA", "PLACA"}, stg_SP_JustEntrega, {"DATA_JANELA", "PLACA"}, "Just", JoinKind.LeftOuter),
				    ExpandeJustificativa = Table.ExpandTableColumn(MesclaJustificativa, "Just", {"JUSTIFICATIVA", "AREA_RESPONSAVEL"}),
				    MetasEntrega = Table.SelectRows(stg_SP_Metas, each [PROCESSO] = "ENTREGA"),
				    MesclaMeta = Table.NestedJoin(ExpandeJustificativa, {"TIPO_ATENDIMENTO"}, MetasEntrega, {"SERVICO_KPI"}, "Meta", JoinKind.LeftOuter),
				    ExpandeMeta = Table.ExpandTableColumn(MesclaMeta, "Meta", {"MINUTOS"}, {"META_MINUTOS"}),
				    AtrasoChegada = Table.AddColumn(ExpandeMeta, "MIN_ATRASO_CHEGADA", each fnMinutos([DATA_JANELA], [DATA_GATE_IN]), type number),
				    EsperaCarregamento = Table.AddColumn(AtrasoChegada, "MIN_ESPERA_CARREGAMENTO", each fnMinutos([DATA_GATE_IN], [INICIO_CARREGAMENTO]), type number),
				    Carregamento = Table.AddColumn(EsperaCarregamento, "MIN_CARREGAMENTO", each fnMinutos([INICIO_CARREGAMENTO], [FIM_CARREGAMENTO]), type number),
				    Saida = Table.AddColumn(Carregamento, "MIN_LIBERACAO_SAIDA", each fnMinutos([FIM_CARREGAMENTO], [DATA_GATE_OUT]), type number),
				    Ciclo = Table.AddColumn(Saida, "MIN_CICLO_TOTAL", each fnMinutos([DATA_GATE_IN], [DATA_GATE_OUT]), type number),
				    StatusKPI = Table.AddColumn(Ciclo, "STATUS_KPI", each
				        if [STATUS] <> "FINALIZADO" or [MIN_CICLO_TOTAL] = null then null
				        else if [MIN_CICLO_TOTAL] <= [META_MINUTOS] then "NO PRAZO"
				        else "FORA DO PRAZO", type text),
				    Pontualidade = Table.AddColumn(StatusKPI, "PONTUALIDADE_CHEGADA", each
				        if [DATA_GATE_IN] = null then null
				        else if [MIN_ATRASO_CHEGADA] <= 30 then "NO HORÁRIO" else "ATRASADO", type text),
				    DataReferencia = Table.AddColumn(Pontualidade, "DATA_REFERENCIA", each DateTime.Date([DATA_JANELA]), type date),
				    HoraJanela = Table.AddColumn(DataReferencia, "HORA_JANELA", each Time.Hour(DateTime.Time([DATA_JANELA])), Int64.Type),
				    // atraso sem justificativa fica explícito no gráfico de motivos
				    SemJustificativa = Table.ReplaceValue(HoraJanela, each [JUSTIFICATIVA], each if [JUSTIFICATIVA] = null and [STATUS_KPI] = "FORA DO PRAZO" then "SEM JUSTIFICATIVA" else [JUSTIFICATIVA], Replacer.ReplaceValue, {"JUSTIFICATIVA"}),
				    Colunas = Table.SelectColumns(SemJustificativa, {
				        "TICKET", "STATUS", "DATA_REFERENCIA", "DATA_JANELA", "HORA_JANELA", "PLACA", "ID_TRANSPORTADORA", "LOTE", "ID_CLIENTE",
				        "TIPO_DOCUMENTO", "TIPO_ATENDIMENTO", "QTD_VOLUMES", "PESO_KG", "DATA_PRE_GATE", "DATA_GATE_IN", "INICIO_CARREGAMENTO",
				        "FIM_CARREGAMENTO", "DATA_GATE_OUT", "MIN_ATRASO_CHEGADA", "MIN_ESPERA_CARREGAMENTO", "MIN_CARREGAMENTO",
				        "MIN_LIBERACAO_SAIDA", "MIN_CICLO_TOTAL", "META_MINUTOS", "STATUS_KPI", "PONTUALIDADE_CHEGADA", "JUSTIFICATIVA", "AREA_RESPONSAVEL"
				    })
				in
				    Colunas

