	column JUSTIFICATIVA
		dataType: string
		lineageTag: ab0814b1-ebdb-4706-b519-2e7f5f55b8ef
		summarizeBy: none
		sourceColumn: JUSTIFICATIVA

	column AREA_RESPONSAVEL
		dataType: string
		lineageTag: 49ba8de5-a169-4602-bc65-e92669d7aee2
		summarizeBy: none
		sourceColumn: AREA_RESPONSAVEL

	partition fConferencia = m
		mode: import
		queryGroup: '5 Fatos'
		source =
				let
				    Origem = stg_TOS_Conferencia,
				    // cancelados e fotografia de contêiner não entram no indicador (mesma regra do painel original)
				    SoKPI = Table.SelectRows(Origem, each [STATUS] <> "CANCELADO" and [SERVICO] <> "POS. FOTOGRAFIA CONTÊINER"),
				    ContainerPadronizado = Table.TransformColumns(SoKPI, {{"CONTAINER", fnLimparContainer, type text}}),
				    ServicoKPI = Table.AddColumn(ContainerPadronizado, "SERVICO_KPI", each
				        if Text.StartsWith([SERVICO], "DESUNITIZAÇÃO") then [SERVICO]
				        else if [GRUPO_FISCAL] = "MAPA/ANVISA" then "MAPA/ANVISA - SERVIÇOS SEM DESOVA"
				        else "RFB - SERVIÇOS SEM DESOVA", type text),
				    MesclaControle = Table.NestedJoin(ServicoKPI, {"ID_POSIC_MERC"}, stg_SP_Conferencia, {"ID_POSIC_MERC"}, "Controle", JoinKind.LeftOuter),
				    ExpandeControle = Table.ExpandTableColumn(MesclaControle, "Controle", {"DATA_PEDIDO_ICONFERE", "DATA_LIBERACAO_FISCAL", "SETOR", "CANAL_PARAMETRIZACAO"}),
				    MesclaJustificativa = Table.NestedJoin(ExpandeControle, {"ID_POSIC_MERC"}, stg_SP_JustConferencia, {"ID_POSIC_MERC"}, "Just", JoinKind.LeftOuter),
				    ExpandeJustificativa = Table.ExpandTableColumn(MesclaJustificativa, "Just", {"JUSTIFICATIVA", "AREA_RESPONSAVEL"}),
				    // o relógio do posicionamento só corre com o contêiner já no terminal
				    InicioPosicionamento = Table.AddColumn(ExpandeJustificativa, "INICIO_POSICIONAMENTO", each List.Max({[DATA_PEDIDO], [ENTRADA_CTNR]}), type datetime),
				    // RFB: conta a partir do pedido do fiscal no iConfere; MAPA/ANVISA: a partir do pedido no TOS
				    InicioServico = Table.AddColumn(InicioPosicionamento, "INICIO_SERVICO", each if [GRUPO_FISCAL] = "RFB" then [DATA_PEDIDO_ICONFERE] else [INICIO_POSICIONAMENTO], type datetime),
				    MetaPosicionamento = Table.AddColumn(InicioServico, "META_POSICIONAMENTO", each fnAplicarMeta([INICIO_POSICIONAMENTO], "CONFERÊNCIA", "POSICIONAMENTO", "TODOS"), type datetime),
				    MetaRelatorio = Table.AddColumn(MetaPosicionamento, "META_ENVIO_RELATORIO", each fnAplicarMeta([INICIO_SERVICO], "CONFERÊNCIA", "ENVIO DO RELATÓRIO", [SERVICO_KPI]), type datetime),
				    HorasPosicionamento = Table.AddColumn(MetaRelatorio, "HORAS_POSICIONAMENTO", each fnHoras([INICIO_POSICIONAMENTO], [DATA_POSICIONADO]), type number),
				    HorasAtendimento = Table.AddColumn(HorasPosicionamento, "HORAS_ATENDIMENTO_FISCAL", each fnHoras([INICIO_SERVICO], [DATA_FECHAMENTO]), type number),
				    HorasCiclo = Table.AddColumn(HorasAtendimento, "HORAS_CICLO_TOTAL", each fnHoras([DATA_PEDIDO], [DATA_FECHAMENTO]), type number),
				    StatusPosicionamento = Table.AddColumn(HorasCiclo, "STATUS_POSICIONAMENTO", each fnStatusPrazo([DATA_POSICIONADO], [META_POSICIONAMENTO]), type text),
				    StatusRelatorio = Table.AddColumn(StatusPosicionamento, "STATUS_ENVIO_RELATORIO", each fnStatusPrazo([DATA_FECHAMENTO], [META_ENVIO_RELATORIO]), type text),
				    PedidoAntesDescarga = Table.AddColumn(StatusRelatorio, "PEDIDO_ANTES_DESCARGA", each [DATA_PEDIDO] < [ENTRADA_CTNR], type logical),
				    DataReferencia = Table.AddColumn(PedidoAntesDescarga, "DATA_REFERENCIA", each DateTime.Date([DATA_PEDIDO]), type date),
				    // atraso sem justificativa fica explícito no gráfico de motivos
				    SemJustificativa = Table.ReplaceValue(DataReferencia, each [JUSTIFICATIVA], each if [JUSTIFICATIVA] = null and [STATUS_ENVIO_RELATORIO] = "FORA DO PRAZO" then "SEM JUSTIFICATIVA" else [JUSTIFICATIVA], Replacer.ReplaceValue, {"JUSTIFICATIVA"}),
				    Colunas = Table.SelectColumns(SemJustificativa, {
				        "ID_POSIC_MERC", "CONTAINER", "ISO", "ID_CLIENTE", "SERVICO", "SERVICO_KPI", "GRUPO_FISCAL", "SETOR", "CANAL_PARAMETRIZACAO", "STATUS",
				        "DATA_REFERENCIA", "ENTRADA_CTNR", "DATA_PEDIDO", "DATA_PROGRAMADO", "INICIO_POSICIONAMENTO", "DATA_POSICIONADO", "META_POSICIONAMENTO",
				        "DATA_PEDIDO_ICONFERE", "INICIO_SERVICO", "DATA_LIBERACAO_FISCAL", "DATA_FECHAMENTO", "META_ENVIO_RELATORIO",
				        "HORAS_POSICIONAMENTO", "HORAS_ATENDIMENTO_FISCAL", "HORAS_CICLO_TOTAL", "STATUS_POSICIONAMENTO", "STATUS_ENVIO_RELATORIO",
				        "PEDIDO_ANTES_DESCARGA", "JUSTIFICATIVA", "AREA_RESPONSAVEL"
				    })
				in
				    Colunas

