# Copie para .env e preencha. O .env não é versionado.

# API do sistema de agendamento de vistorias (OAuth2 password grant) – etapa 1
AGENDAMENTO_TOKEN_URL=https://auth.exemplo.com/connect/token
AGENDAMENTO_API_URL=https://api.exemplo.com/agendamentos-conferencia
AGENDAMENTO_CLIENT_ID=
AGENDAMENTO_CLIENT_SECRET=
AGENDAMENTO_USUARIO=
AGENDAMENTO_SENHA=

# SharePoint – todas as etapas
SHAREPOINT_SITE_URL=https://sua-empresa.sharepoint.com/sites/seu-site
SHAREPOINT_USUARIO=usuario@sua-empresa.com
SHAREPOINT_SENHA=
SHAREPOINT_LISTA_VISTORIAS=vistorias
SHAREPOINT_LISTA_TERMOS_RISCO=termos_de_risco

# Banco Oracle – etapa 2
ORACLE_USUARIO=
ORACLE_SENHA=
ORACLE_DSN=host:1521/servico

